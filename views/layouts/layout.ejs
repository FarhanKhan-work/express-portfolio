<!DOCTYPE html>
<!--
  views/layouts/layout.ejs
  this is my main layout file, every page on my site uses it
  I set it up in app.js with express-ejs-layouts
  it has the head stuff, the header, the footer, and a spot in the middle where each page goes
-->
<html lang="en">
<head>
  <!-- makes sure all characters show properly -->
  <meta charset="UTF-8">

  <!-- makes the site fit on phones and smaller screens -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- short description of my site for search engines -->
  <meta name="description" content="Portfolio of <%= siteOwner %>, Networking and IT Security student">

  <!-- the browser tab title, title comes from the route and siteOwner comes from app.locals -->
  <title><%= title %> | <%= siteOwner %></title>

  <!-- Bootstrap 5 for the layout and styling (source: https://getbootstrap.com) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

  <!-- Font Awesome for all my icons (source: https://fontawesome.com) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <!-- Poppins font from Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap">

  <!-- my own CSS file, I don't write "public" in the path because express already serves the public folder -->
  <link rel="stylesheet" href="/stylesheets/style.css">

  <!-- the little icon in the browser tab -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
</head>

<!-- these Bootstrap classes make the footer stay at the bottom even if the page is short -->
<body class="d-flex flex-column min-vh-100">

  <!-- pulling in my header partial (navbar) -->
  <%- include('../partials/header') %>

  <!-- this is where each page's content gets put in -->
  <main class="flex-grow-1">
    <%- body %>
  </main>

  <!-- pulling in my footer partial -->
  <%- include('../partials/footer') %>
  
  <!-- back to top button, it's hidden until you scroll down (my script.js controls it) -->
  <button id="backToTop" class="btn btn-info rounded-circle shadow" aria-label="Back to top">
    <i class="fa-solid fa-arrow-up"></i>
  </button>

  <!-- Bootstrap JavaScript, I need this so the menu button works on phones -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- my own JavaScript file -->
  <script src="/javascripts/script.js"></script>
</body>
</html>