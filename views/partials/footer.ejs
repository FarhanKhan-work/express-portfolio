<!--
  views/partials/footer.ejs
  my footer, it shows at the bottom of every page
  it has my GitHub and LinkedIn links like the assignment asks
  the links come from app.locals in app.js
-->
<footer class="bg-main text-light py-4 mt-5">
  <!-- on phones it stacks, on bigger screens it goes side by side -->
  <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">

    <!-- copyright line, the year gets filled in by my script.js file -->
    <p class="mb-0 small">&copy; <span id="year"></span> <%= siteOwner %>. Built with Express, EJS and Bootstrap.</p>
    
    <!-- quick links to my pages so people can jump around from the bottom too -->
    <ul class="list-inline mb-0 small">
      <li class="list-inline-item"><a href="/" class="text-light text-decoration-none">Home</a></li>
      <li class="list-inline-item"><a href="/about" class="text-light text-decoration-none">About</a></li>
      <li class="list-inline-item"><a href="/projects" class="text-light text-decoration-none">Projects</a></li>
      <li class="list-inline-item"><a href="/contact" class="text-light text-decoration-none">Contact</a></li>
    </ul>



    <!-- my social links with Font Awesome icons -->
    <div class="social-links">

      <!-- GitHub link, target _blank opens it in a new tab -->
      <a href="<%= githubUrl %>" target="_blank" rel="noopener" aria-label="GitHub" class="text-light me-3">
        <i class="fa-brands fa-github fa-xl"></i>
      </a>

      <!-- LinkedIn link -->
      <a href="<%= linkedinUrl %>" target="_blank" rel="noopener" aria-label="LinkedIn" class="text-light me-3">
        <i class="fa-brands fa-linkedin fa-xl"></i>
      </a>

      <!-- email link, mailto opens their email app -->
      <a href="mailto:<%= email %>" aria-label="Email" class="text-light">
        <i class="fa-solid fa-envelope fa-xl"></i>
      </a>

    </div>
  </div>
</footer>
